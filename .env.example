# Required. Data lives in Supabase (lib/data.ts / lib/supabaseClient.ts).
# Project Settings -> API in your Supabase project. The service role key
# bypasses Row Level Security and is used server-only — never expose it to
# the browser. Run supabase/schema.sql in the SQL Editor before starting the
# app for the first time (it creates the `skills` and `executions` tables).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. When set, "paste a post -> draft skill" uses Claude to extract
# name/description/input fields instead of the heuristic fallback, and
# skills that don't require Cowork are dispatched directly through the
# Anthropic API.
ANTHROPIC_API_KEY=

# Optional. Skills-Hub does not assume a specific Cowork dispatch mechanism.
# Set this to the webhook/endpoint URL your current Cowork integration
# exposes once you have one; until it's set, Cowork-dependent skills are
# marked "needs setup" instead of being run or faked.
COWORK_DISPATCH_WEBHOOK_URL=
COWORK_DISPATCH_TOKEN=

# Optional but recommended once you're deployed. Protects GET
# /api/cron/run-scheduled (scheduled skill runs, see README "Scheduling a
# skill to run itself") — Vercel automatically sends this as a Bearer token
# on its own cron requests once the env var is set; without it, the route
# has no auth check at all.
CRON_SECRET=

# Optional. When set, a scheduled run that ends in error/needs_setup POSTs a
# {"text": "..."} alert here (Slack's own "Incoming Webhook" shape — a Slack
# webhook URL works as-is). See README "Alerting when a scheduled run fails".
SCHEDULE_FAILURE_WEBHOOK_URL=

# Optional. Needed for a "video" input field pointed at an X/Twitter link
# (lib/transcribe.ts downloads the video and sends it to OpenAI's
# /v1/audio/transcriptions). Not needed for YouTube (uses the video's own
# captions, no external service) — Instagram isn't supported yet either way.
# See README "Transcribing a video link".
OPENAI_API_KEY=

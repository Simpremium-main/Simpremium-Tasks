# SQLite by default — swap to Postgres/MySQL later by changing the provider
# in prisma/schema.prisma and this URL.
DATABASE_URL="file:./dev.db"

# Optional. When set, "paste a post -> draft skill" uses Claude to extract
# name/description/input fields instead of the heuristic fallback, and
# skills that don't require Cowork are dispatched directly through the
# Anthropic API.
ANTHROPIC_API_KEY=

# Optional. Skills-Hub does not assume a specific Cowork dispatch mechanism.
# Set this to the webhook/endpoint URL your current Cowork integration
# exposes once you have one; until it's set, Cowork-dependent skills are
# marked "needs setup" instead of being run or faked.
COWORK_DISPATCH_WEBHOOK_URL=
COWORK_DISPATCH_TOKEN=

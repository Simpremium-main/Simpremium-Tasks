# Copy this file to .env in this same folder and fill in the two required
# values. See README.md for the full setup walkthrough.

# Required. Your deployed dashboard's URL (no trailing slash), e.g.
# https://simpremium-tasks.vercel.app
DASHBOARD_URL=

# Required. Must be the exact same value as COWORK_AGENT_TOKEN in the
# dashboard's own environment variables (Vercel → Project Settings →
# Environment Variables). Generate any long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COWORK_AGENT_TOKEN=

# Optional. How often (in milliseconds) this agent checks the dashboard
# for a new queued Cowork job. Default: 15000 (15s).
POLL_INTERVAL_MS=15000

# Optional. How long (in milliseconds) to wait for Cowork to save a result
# file before giving up and reporting the run as failed. Default: 1200000
# (20 minutes) — raise this for skills you expect to take longer.
RESULT_TIMEOUT_MS=1200000

# Optional. Where this agent tells Cowork to save its final answer, and
# where it watches for that file to show up. Default: ~/CoworkAgent/results
RESULTS_DIR=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite to start — zero setup, single file, trivial to swap to
  // Postgres later by changing this provider + DATABASE_URL.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A reusable prompt/instruction captured from a post, ready to run.
model Skill {
  id             String   @id @default(cuid())
  name           String
  description    String
  status         String   @default("draft") // draft | active
  needsInput     Boolean  @default(false)
  usesCowork     Boolean  @default(false)
  promptTemplate String // instruction sent when run; may reference {{fieldKey}} placeholders
  inputSchema    String? // JSON array of InputField, see lib/types.ts
  sourcePost     String? // original pasted post content, kept for reference
  confirmedOnce  Boolean  @default(false) // whether the first-run confirmation has been shown
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  executions Execution[]
}

// One run of a skill, successful or not — every attempt is recorded.
model Execution {
  id             String    @id @default(cuid())
  skillId        String
  skill          Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  status         String // pending | running | success | error | needs_setup
  source         String // cowork | claude | manual
  inputValues    String? // JSON of the filled-in inputs, secret fields masked before storage
  promptSnapshot String // the final assembled instruction, secret values masked
  result         String?
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([skillId])
  @@index([startedAt])
}
